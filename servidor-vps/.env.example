# Copie para .env e preencha antes de rodar "docker compose up -d".

# Domínio apontado para o IP da VPS (registro A). O certificado TLS é emitido
# para ele automaticamente.
RYKE_DOMINIO=ryke.seudominio.com.br

# Credenciais do TURN. Invente uma senha longa: quem a tiver consegue usar sua
# VPS como retransmissor de tráfego.
TURN_USUARIO=ryke
TURN_SENHA=troque-esta-senha-por-uma-bem-longa
